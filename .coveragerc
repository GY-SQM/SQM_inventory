[run]
source = engine_modules, api, core, features, parsers, gui_app_modular
omit =
    */test_*
    */__pycache__/*
    _archive/*
    backup_*/*
    scripts/*
    SQM_v612_Clean_Build/*
    SQM_v701_Outbound_Only/*
    SQM_All_Session_Patches_v701/*

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    if __name__ == .__main__
    raise NotImplementedError
    pass
    except ImportError
    if TYPE_CHECKING

show_missing = true
precision = 1
fail_under = 0

[html]
directory = htmlcov
title = SQM v6.2.7 Coverage Report

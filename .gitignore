# SQM Inventory Management - .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg
.pytest_cache/
py.typed

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Environment
.env
.env.local
venv/
.venv/

# Database (런타임 생성)
data/db/*.db
data/db/*.db-journal
data/db/*.db-wal
data/db/*.db-shm
data/db/backups/

# Backup (런타임 생성)
backup/

# Logs
logs/*.log
logs/*.log.*

# Output (런타임 생성)
output/
temp/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Docs build
docs/build/

# Settings (API 키 포함 가능)
settings.ini

# Runtime config (사용자별 생성)
window_config.json
theme_preference.json
query_history.json
gui_config.json

# SQM Inventory Management - .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg
.pytest_cache/
py.typed

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.cursor/

# Environment
.env
.env.local
venv/
.venv/

# Database (런타임 생성)
data/db/*.db
data/db/*.db-journal
data/db/*.db-wal
data/db/*.db-shm
data/db/backups/
*.db
!data/db/sqm_inventory.db

# Backup (런타임 생성 및 아카이브)
backup/
BACKUP/
LEGACY/
OLD/
WORK/
archive/

# Logs
logs/*.log
logs/*.log.*
*.log

# Output (런타임 생성)
output/
temp/
tmp/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Docs build
docs/build/

# Settings (API 키 포함 가능)
settings.ini

# Runtime config (사용자별 생성)
window_config.json
theme_preference.json
query_history.json
gui_config.json

# Large Archives & Other Versions (Clean Build 유지)
*.zip
*.7z
*.rar
SQM_v701_FULL-1/
SQM_v611/
generated_allocation/
terminals/
agent-transcripts/
clean_export.py

# 아카이브 (운영 코드 아님)
_archive/

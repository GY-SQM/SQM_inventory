+def parse_weight_kg(value: Any, unit_mode: str = 'kg', default: float = 0.0) -> float:
+    """중량 문자열/숫자를 **kg**로 안전 변환합니다.
+
+    지원 케이스:
+      - '5.001'  → 5001   (점이 천단위 구분자인 케이스)
+      - '5,001'  → 5001
+      - '5.131,250' → 5131.250  (유럽식: '.' 천단위, ',' 소수)
+      - '5,131.250' → 5131.250  (미국식: ',' 천단위, '.' 소수)
+
+    unit_mode:
+      - 'kg' (기본): 숫자를 kg로 해석 (자동 MT 변환 **하지 않음**)
+      - 'mt': 숫자를 MT로 해석 후 kg로 변환하되, 1000 이상 큰 값은 이미 kg일 가능성이 높아 그대로 둠
+
+    Notes:
+      - 리오님 정책: '5.001'은 5.001톤이 아니라 '5,001kg' 표기로 해석하는 케이스가 많음.
+      - 단위가 혼동될 수 있으므로, UI에서 unit_mode를 명시적으로 선택하도록 설계.
+    """
+    if value is None:
+        return default
+
+    # 숫자면 그대로 처리
+    if isinstance(value, (int, float)):
+        num = float(value)
+    else:
+        s = str(value).strip()
+        if not s or s == '-':
+            return default
+        # 숫자/구분자만 남김
+        s = re.sub(r'[^\d.,]', '', s)
+        if not s:
+            return default
+
+        # 케이스: 둘 다 존재 (유럽/미국식)
+        if ',' in s and '.' in s:
+            last_comma = s.rfind(',')
+            last_dot = s.rfind('.')
+            # 마지막 구분자가 소수점으로 간주
+            if last_comma > last_dot:
+                # 유럽식: '.' 천단위, ',' 소수
+                s2 = s.replace('.', '').replace(',', '.')
+            else:
+                # 미국식: ',' 천단위, '.' 소수
+                s2 = s.replace(',', '')
+            try:
+                num = float(s2)
+            except ValueError:
+                return default
+        # 케이스: 점만 있고 '1.234' 형태면 천단위로 간주
+        elif '.' in s and re.fullmatch(r'\d{1,3}(?:\.\d{3})+', s):
+            try:
+                num = float(s.replace('.', ''))
+            except ValueError:
+                return default
+        # 케이스: 쉼표만 있고 '1,234' 형태면 천단위로 간주
+        elif ',' in s and re.fullmatch(r'\d{1,3}(?:,\d{3})+', s):
+            try:
+                num = float(s.replace(',', ''))
+            except ValueError:
+                return default
+        else:
+            # 일반 float
+            try:
+                num = float(s.replace(',', ''))
+            except ValueError:
+                return default
+
+    unit = (unit_mode or 'kg').strip().lower()
+    if unit in ('mt', 'ton', 'metric_ton', 'metric-ton'):
+        # MT 선택 시: 보통 0~100 범위, 1000 이상은 이미 kg일 가능성이 높음
+        if num < 1000:
+            return num * 1000.0
+        return num
+    # 기본 kg
+    return num

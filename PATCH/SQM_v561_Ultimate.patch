-                        return parsed
-                except json.JSONDecodeError as _e:
-                    logger.debug(f"Suppressed: {_e}")
-        
-        # 2b: 단일 ``` ... ``` (기존 2차 호환)
-        code_match = re.search(r'```\s*([\s\S]*?)\s*```', text)

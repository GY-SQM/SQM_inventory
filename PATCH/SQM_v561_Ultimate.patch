 # API 키 검증
+
+def save_weight_settings(unit: str = 'kg', sample_weight_kg: float = 1.0, unit_confirmed: bool = True) -> bool:
+    """중량 단위(kg/mt) + 샘플 무게(kg, BL 공통)를 settings.ini [Weights]에 저장."""
+    try:
+        config = configparser.ConfigParser()
+        if SETTINGS_FILE.exists():
+            config.read(SETTINGS_FILE, encoding='utf-8')
+        if not config.has_section('Weights'):
+            config.add_section('Weights')
+        u = (unit or 'kg').strip().lower()
+        if u not in ('kg', 'mt'):
+            u = 'kg'
+        config.set('Weights', 'unit', u)
+        config.set('Weights', 'unit_confirmed', 'true' if unit_confirmed else 'false')
+        try:
+            sw = float(sample_weight_kg)
+        except (ValueError, TypeError):
+            sw = 1.0
+        if sw <= 0:
+            sw = 1.0
+        config.set('Weights', 'sample_weight_kg', str(sw))
+        with open(SETTINGS_FILE, 'w', encoding='utf-8') as f:
+            config.write(f)
+        return True
+    except (OSError, IOError, PermissionError):
+        return False
+

# SQM Inventory v3.1 환경 설정
# 이 파일을 .env로 복사하고 값을 설정하세요.
# 
# 주의: .env 파일은 절대 Git에 커밋하지 마세요!

# ============================================================
# API 키 (필수 - AI 기능 사용 시)
# ============================================================
SQM_GEMINI_API_KEY=your_gemini_api_key_here
SQM_GOOGLE_VISION_API_KEY=your_vision_api_key_here

# ============================================================
# 데이터베이스 설정
# ============================================================
SQM_DB_PATH=data/db/sqm_inventory.db
SQM_BACKUP_PATH=data/db/backups

# ============================================================
# 로깅 설정
# ============================================================
# 레벨: DEBUG, INFO, WARNING, ERROR, CRITICAL
SQM_LOG_LEVEL=INFO
SQM_LOG_FILE=logs/sqm_inventory.log

# ============================================================
# UI 설정
# ============================================================
# 테마: flatly, cosmo, darkly, cyborg, solar, superhero, morph
SQM_THEME=flatly
SQM_LANGUAGE=ko

# ============================================================
# 백업 설정
# ============================================================
SQM_AUTO_BACKUP=true
SQM_BACKUP_INTERVAL_HOURS=24
SQM_MAX_BACKUP_COUNT=10

# ============================================================
# 업데이트 설정 (선택)
# ============================================================
# 자동 업데이트 확인
SQM_AUTO_UPDATE_CHECK=true
# 로컬 네트워크 업데이트 서버 (회사 내부용)
# SQM_UPDATE_SERVER=\\\\192.168.1.100\\shared\\sqm_updates
# 인터넷 업데이트 URL
# SQM_UPDATE_URL=https://api.github.com/repos/user/sqm-inventory/releases/latest

# ============================================================
# 네트워크 설정 (선택)
# ============================================================
# 프록시 설정 (필요시)
# SQM_PROXY_URL=http://proxy.company.com:8080
# SQM_PROXY_USER=username
# SQM_PROXY_PASS=password

# ============================================================
# 고급 설정
# ============================================================
# 개발 모드 (디버그 정보 표시)
SQM_DEBUG_MODE=false
# 성능 모니터링
SQM_PERFORMANCE_MONITOR=false
# 최대 동시 처리 수
SQM_MAX_WORKERS=4
